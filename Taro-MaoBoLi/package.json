{
    "name": "aurora-glass-site",
    "version": "1.0.0",
    "private": true,
    "description": "极光液态毛玻璃 · 多端个人网站（Taro 4 + React 18 + TypeScript）",
    "scripts": {
        "dev": "taro build --type h5 --watch",
        "dev:h5": "taro build --type h5 --watch",
        "build:h5": "taro build --type h5",
        "dev:weapp": "taro build --type weapp --watch",
        "build:weapp": "taro build --type weapp",
        "dev:harmony": "taro build --type harmony --watch",
        "build:harmony": "taro build --type harmony",
        "dev:android": "taro build --type rn --platform android",
        "dev:ios": "taro build --type rn --platform ios",
        "build:android": "taro build --type rn --platform android --no-watch",
        "build:ios": "taro build --type rn --platform ios --no-watch",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@tarojs/components": "4.2.1",
        "@tarojs/plugin-framework-react": "4.2.1",
        "@tarojs/plugin-platform-h5": "4.2.1",
        "@tarojs/plugin-platform-harmony-ets": "4.2.1",
        "@tarojs/plugin-platform-weapp": "4.2.1",
        "@tarojs/react": "4.2.1",
        "@tarojs/runtime": "4.2.1",
        "@tarojs/taro": "4.2.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
        "@tarojs/cli": "4.2.1",
        "@tarojs/webpack5-runner": "4.2.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "babel-preset-taro": "4.2.1",
        "react-refresh": "^0.14.0",
        "sass": "^1.80.6",
        "typescript": "^5.6.3"
    },
    "engines": {
        "node": ">=18"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "last 2 versions",
        "iOS >= 12",
        "Android >= 7"
    ]
}

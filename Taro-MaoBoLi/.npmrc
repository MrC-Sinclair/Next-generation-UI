# 实测结论：腾讯云镜像会忽略 npm 的 corgi 精简元数据请求头，
# 每个包返回 6.3MB 全量 metadata（npmmirror 只返回 2.2MB），大依赖树下会拖垮解析。
registry=https://registry.npmmirror.com/

# Taro 依赖了大量未显式声明的传递依赖，用扁平化结构最稳妥
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=false

# @tarojs/plugin-framework-react 声明了 peerOptional vite@^4，
# 而本项目用 webpack5 编译器并不装 vite，npm 10 会卡在 ERESOLVE 上反复重试。
legacy-peer-deps=true

fetch-timeout=120000
fetch-retries=5

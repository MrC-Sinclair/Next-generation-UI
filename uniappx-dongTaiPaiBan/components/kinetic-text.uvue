<template>
  <view class="kt" :style="wrapStyle" @click="handleTap">
    <view
      v-for="(ch, idx) in chars"
      :key="idx"
      class="kt__cell"
      :style="cellStyle(idx)"
    >
      <text class="kt__ch" :style="chStyle(idx)">{{ ch }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 动态排版核心组件
 *
 * 思路：把整句拆成单字，每个字由「同一条时间轴 + 各自相位」独立计算 transform。
 * 相位差制造波浪，频率与阻尼制造情绪。所有形变只用 translate / rotate / skew / scale，
 * 这四项在 uvue 的六端（Android / iOS / 鸿蒙 / Web / 小程序）表现完全一致。
 *
 * 支持的情绪模式：
 *   breathe 呼吸   bounce 弹跳   wave 波浪
 *   distort 扭曲   melt 融化     glitch 故障
 *
 * 另有三项全局手感：
 * - 话语引擎：短语型情绪（bounce/distort/glitch/melt）按「表达 → 归于静止」循环播放，
 *   词语成组移动、各行按文本哈希错峰，静止时文字完全归位为纸白常态——
 *   情绪是"偶发的表达"，不是永不停歇的装饰循环；
 * - 挂载后一次性逐字入场（错峰升起），reduced / ALLOW_MOTION=false 时跳过；
 * - 自适应帧率：按字数选帧间隔，tick 按真实时长归一化，帧率不影响动画速度。
 */

import { ref, computed, onMounted, onUnmounted, type ComputedRef } from 'vue'
import { appActive } from '../common/app-state'
import { ALLOW_MOTION } from '../common/site'
import { themeResolve } from '../common/theme'

const props = defineProps({
  /** 要动的文字，建议不超过 20 字，移动端超过会掉帧 */
  text: { type: String, default: 'KINETIC' },
  /** 情绪模式：breathe / bounce / wave / distort / melt / glitch */
  mode: { type: String, default: 'wave' },
  /** 字号（px） */
  fontSize: { type: Number, default: 48 },
  /** 行高倍数 */
  lineHeight: { type: Number, default: 1.08 },
  /** 字重 */
  fontWeight: { type: String, default: '700' },
  /** 基础色 */
  color: { type: String, default: '#F5F3EF' },
  /** 强调色，用于波峰染色与故障色散 */
  accent: { type: String, default: '#FF4D2E' },
  /** 形变幅度（px），越大越夸张 */
  amplitude: { type: Number, default: 12 },
  /** 速度倍数 */
  speed: { type: Number, default: 1 },
  /** 字距（px） */
  letterSpacing: { type: Number, default: 0 },
  /** 暂停动画（页面隐藏/离开视口时置 true 可停帧省电） */
  paused: { type: Boolean, default: false },
  /** 减弱动效：true 时静态渲染（无位移/无冲击波/无定时器），供系统级"减弱动态效果"或局部降级使用 */
  reduced: { type: Boolean, default: false },
  /** 是否响应点击：点击后触发一次冲击波 */
  interactive: { type: Boolean, default: false },
  /** 对齐方式 */
  align: { type: String, default: 'flex-start' }
})

// 事件名用 press 而不是 tap，避免和原生 tap 事件在组件上撞车
const emit = defineEmits(['press'])

/** #12：颜色统一经主题解析——深色原样、浅色调墨降档（glow/glitch 阴影同理），保证动效在浅色下不刺眼 */
const effColor: ComputedRef<string> = computed(() => themeResolve(props.color))
const effAccent: ComputedRef<string> = computed(() => themeResolve(props.accent))
/** glitch 的绿色散光在浅色主题下降为深绿 */
const effGreen: ComputedRef<string> = computed(() => themeResolve('#00E5A0'))

const tick = ref(0)
/** 减弱动效生效条件：显式 prop 或全局 ALLOW_MOTION=false（见 common/site.uts） */
const effReduced: ComputedRef<boolean> = computed(() => props.reduced || !ALLOW_MOTION)
/** 点击冲击波的衰减值 0~1 */
const impact = ref(0)
/** 冲击波起始位置（字索引） */
const impactOrigin = ref(0)

// 显式标注 number：避免 UTS 把 0 推断成 Int，和 setInterval 的返回值类型对不上
let timer: number = 0

const chars: ComputedRef<string[]> = computed(() => {
  const arr: string[] = props.text.split('')
  const out: string[] = []
  for (let i = 0; i < arr.length; i++) {
    // 空格换成不换行空格，否则 flex 行内容易被折叠
    out.push(arr[i] === ' ' ? '\u00A0' : arr[i])
  }
  return out
})

/**
 * 容器样式：额外预留上下内边距（取 1.1×形变幅度 与 0.25×字号 的较大值），
 * 让 bounce 上弹 / melt 拉伸等大位移有安全空间，
 * 不会压住上方元素、也不会侵入下方正文。仅扩展可用区域，不改动形变算法。
 */
const wrapStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const pad = Math.round(Math.max(props.amplitude * 1.1, props.fontSize * 0.25))
  return {
    'justify-content': props.align,
    'flex-wrap': 'wrap',
    'padding-top': pad + 'px',
    'padding-bottom': pad + 'px'
  }
})

/** 入场时长与逐字错峰（tick 单位，1 tick = 60ms 标称时间）：总时长 ≈ 0.42s + 字数 × 42ms */
const ENT_DUR: number = 7
const ENT_GAP: number = 0.7

/** 单字入场进度 0→1，1 表示已完成 */
const entranceAt = (idx: number): number => {
  const p = (tick.value - idx * ENT_GAP) / ENT_DUR
  if (p <= 0) return 0
  if (p >= 1) return 1
  return p
}

/** 断句符：出现即重置词组相位 */
const isBreakChar = (ch: string): boolean => {
  return ch === ' ' || ch === '　' || ch === ',' || ch === '.' || ch === '!' || ch === '?' ||
    ch === '，' || ch === '。' || ch === '！' || ch === '？' || ch === '、' || ch === '；' ||
    ch === '：' || ch === '·' || ch === '《' || ch === '》' || ch === '（' || ch === '）' || ch === '—'
}

/** 字相位：组内微差（0.18）+ 词组间大差（0.75）。中文无分词，每 2 字一组——动效跟随词语节奏，而非逐字波纹 */
const charPhase = (idx: number): number => {
  const arr = props.text.split('')
  let phase = 0
  let run = 0
  for (let i = 0; i < idx; i++) {
    phase += 0.18
    run++
    if (isBreakChar(arr[i]) || run >= 2) {
      phase += 0.75
      run = 0
    }
  }
  return phase
}

/** 文本哈希 → 行种子：多行同屏时错开各自的表达时机，避免齐动 */
const lineSeed: ComputedRef<number> = computed(() => {
  const arr = props.text.split('')
  let h = 0
  for (let i = 0; i < arr.length; i++) {
    h = (h + arr[i].charCodeAt(0)) % 997
  }
  return h
})

type Pose = {
  x: number
  y: number
  sx: number
  sy: number
  sk: number
  rot: number
  op: number
  /** 表达强度 0~1：0 = 静止归位；驱动波峰染色与阴影 */
  act: number
  /** 原始抖动值（glitch 红绿色散方向用），其余模式为 0 */
  dir: number
}

/** 情绪短语周期（秒）：雀跃短促、失真稀疏、融化绵长；0 = 连续氛围型（wave/breathe） */
const phraseCycleSecs = (m: string): number => {
  if (m === 'bounce') return 3.4
  if (m === 'distort') return 5.5
  if (m === 'glitch') return 6.5
  if (m === 'melt') return 9.0
  return 0
}

/** 短语时钟：当前位置 u ∈ [0,1)，连续模式返回 -1 */
const phraseU = (m: string): number => {
  const secs = phraseCycleSecs(m)
  if (secs <= 0) return -1
  const cycT = secs * 1.5 * props.speed
  const t = tick.value * 0.09 * props.speed
  let u = ((t + lineSeed.value / 997 * cycT) % cycT) / cycT
  if (u < 0) u += 1
  return u
}

/** 单字位姿：六种情绪的编排都在这里。除 wave/breathe 外，一次表达后全部归零静止 */
const poseAt = (idx: number): Pose => {
  const t = tick.value * 0.09 * props.speed
  const ph = charPhase(idx)
  const amp = props.amplitude
  const seed = lineSeed.value
  const sign = seed % 2 === 0 ? 1 : -1

  let x = 0
  let y = 0
  let sx = 1
  let sy = 1
  let sk = 0
  let rot = 0
  let op = 1
  let act = 0
  let dir = 0

  const m = props.mode

  if (m === 'bounce') {
    // 雀跃：两连跳、逐跳衰减，然后静止——跳动只发生在表达的瞬间
    const u = phraseU(m)
    if (u >= 0 && u <= 0.35) {
      const g = u / 0.35
      const hop = Math.abs(Math.sin(g * Math.PI * 2)) * Math.pow(1 - g, 1.2)
      act = hop
      y += -hop * amp * 1.15
      const squash = Math.abs(Math.cos(g * Math.PI * 2)) * (1 - g)
      sy += squash * 0.2
      sx -= squash * 0.1
    }
  } else if (m === 'wave') {
    // 漂浮：唯一的位移型常动模式，低幅正弦
    const w = Math.sin(t * 1.6 + ph)
    act = (w + 1) / 2 * 0.6
    y += w * amp
    rot += Math.cos(t * 1.6 + ph) * 5
  } else if (m === 'breathe') {
    // 平静：等比呼吸 + 透明度，连续氛围型
    const b = Math.sin(t * 1.2 + ph)
    act = (b + 1) / 2 * 0.5
    sx += b * 0.055
    sy += b * 0.055
    op -= (1 - (b + 1) / 2) * 0.28
  } else if (m === 'distort') {
    // 紧绷：张力缓慢建立 → 释放回正 → 安静等待下一次
    const u = phraseU(m)
    if (u >= 0 && u <= 0.45) {
      const g = u / 0.45
      if (g <= 0.82) {
        const tension = g * g
        act = tension
        sk += sign * (tension * 10 + Math.sin(t * 7 + ph) * 1.6 * tension)
        x += Math.sin(t * 3.1 + ph) * amp * 0.3 * tension
        sx += tension * 0.1
        sy -= tension * 0.08
      } else {
        const r = (g - 0.82) / 0.18
        const recoil = Math.sin(r * Math.PI) * (1 - r)
        act = recoil * 0.3
        sk += -sign * recoil * 6
      }
    }
  } else if (m === 'melt') {
    // 融化：缓慢瘫下去 → 停在底部 → 更缓慢地恢复。疲劳是一次性的，不是往复振荡
    const u = phraseU(m)
    let k = 0
    if (u >= 0) {
      if (u < 0.55) {
        const g = u / 0.55
        k = g * g * (3 - 2 * g)
      } else if (u < 0.75) {
        k = 1
      } else {
        const g = (u - 0.75) / 0.25
        k = 1 - g * g * (3 - 2 * g)
      }
    }
    act = k
    y += k * amp
    sy += k * 0.38
    sx -= k * 0.1
    sk += Math.sin(t * 0.7 + ph) * 3.5 * k
    op -= k * 0.22
  } else if (m === 'glitch') {
    // 失真：大部分时间安静，周期内两次短促抽动——故障是事件，不是常态
    const u = phraseU(m)
    if (u >= 0) {
      const b1 = (seed % 13) / 130
      const burst = (u >= b1 && u <= b1 + 0.09) || (u >= 0.52 && u <= 0.64)
      if (burst) {
        const n = Math.sin(t * 9 + ph * 3.7) * Math.cos(t * 5.3 + ph * 1.9)
        act = Math.abs(n)
        dir = n
        x += n * amp * 0.9
        sk += n * 9
        sy += Math.abs(n) * 0.1
        if (n > 0.45) op -= 0.18
      }
    }
  }

  return { x: x, y: y, sx: sx, sy: sy, sk: sk, rot: rot, op: op, act: act, dir: dir }
}

/**
 * 单字容器样式：承载 transform
 * 用 view 包一层而不是直接变换 text，是因为原生端 text 的变换支持有差异
 */
const cellStyle = (idx: number): UTSJSONObject => {
  // 评审 #5：全局减弱动效（ALLOW_MOTION=false / reduced）时静态渲染，
  // 无色散/无位移/无冲击波——glitch 等高频模式随之停用
  if (effReduced.value) {
    return {
      'transform': 'translate(0px, 0px) rotate(0deg) skewX(0deg) scale(1.000, 1.000)',
      'opacity': '1.000',
      'margin-right': props.letterSpacing + 'px'
    }
  }

  const pose = poseAt(idx)
  let x = pose.x
  let y = pose.y
  let sx = pose.sx
  let sy = pose.sy
  let sk = pose.sk
  let rot = pose.rot
  let op = pose.op

  // 点击冲击波：以点击点为中心向两侧衰减扩散
  if (impact.value > 0.01) {
    const dist = Math.abs(idx - impactOrigin.value)
    const wave = Math.sin(impact.value * Math.PI) * Math.max(0, 1 - dist / 6)
    y -= wave * props.amplitude * 2.2
    sy += wave * 0.35
  }

  // 入场：挂载后一次性逐字升起（easeOutCubic），与情绪形变叠加，结束后零开销
  const ent = entranceAt(idx)
  if (ent < 1) {
    const e = 1 - Math.pow(1 - ent, 3)
    y += (1 - e) * props.fontSize * 0.35
    op *= e
  }

  return {
    'transform':
      'translate(' + x.toFixed(2) + 'px, ' + y.toFixed(2) + 'px) ' +
      'rotate(' + rot.toFixed(2) + 'deg) ' +
      'skewX(' + sk.toFixed(2) + 'deg) ' +
      'scale(' + sx.toFixed(3) + ', ' + sy.toFixed(3) + ')',
    'opacity': op.toFixed(3),
    'margin-right': props.letterSpacing + 'px'
  }
}

/** 单字样式：颜色与阴影。染色跟随表达强度——静止时就是纸白常态，只有表达的瞬间才染上情绪色 */
const chStyle = (idx: number): UTSJSONObject => {
  const pose = poseAt(idx)
  const act = pose.act

  let color = effColor.value
  let shadow = 'none'

  if (props.mode === 'melt') {
    // 没有 CSS filter 的端也能靠加大阴影半径模拟"糊开"
    shadow = '0 ' + (act * 6).toFixed(1) + 'px ' + (act * 10).toFixed(1) + 'px ' + effAccent.value + '33'
    if (act > 0.62) color = effAccent.value
  } else if (props.mode === 'glitch') {
    if (act > 0) {
      const n = pose.dir
      if (n > 0.45) {
        color = effAccent.value
        shadow = '-3px 0 0 ' + effAccent.value + ', 3px 0 0 ' + effGreen.value
      } else if (n < -0.45) {
        shadow = '3px 0 0 ' + effAccent.value + ', -3px 0 0 ' + effGreen.value
      } else if (n > 0) {
        color = effAccent.value
      }
    }
  } else if (act > 0.55) {
    // wave 波峰 / bounce 腾空 / distort 张力峰值 → 染上强调色
    color = effAccent.value
    if (props.mode === 'distort') {
      shadow = '0 0 ' + (act * 14).toFixed(1) + 'px ' + effAccent.value + '55'
    }
  }

  return {
    'font-size': props.fontSize + 'px',
    'line-height': (props.fontSize * props.lineHeight).toFixed(1) + 'px',
    'font-weight': props.fontWeight,
    'color': color,
    'text-shadow': shadow
  }
}

function handleTap() {
  emit('press')
  if (!props.interactive) return
  impactOrigin.value = 0
  impact.value = 1
}

onMounted(() => {
  // 评审 #5：全局减弱动效（ALLOW_MOTION=false / reduced）时不启动定时器，直接静态渲染
  if (effReduced.value) return
  // 自适应帧率：字少算得快，短标题提到 ~25fps；字多回落省电。
  // tick 按 60ms 标称时间归一化推进（60ms = +1），改帧率不改动画速度与节奏
  const n = props.text.length
  const frameMs: number = n <= 8 ? 40 : (n <= 16 ? 50 : 60)
  const step: number = frameMs / 60
  timer = setInterval((): void => {
    // 评审 #3：paused（页面滚动离屏时传 true）或全局退后台（appActive=false，见 common/app-state.uts）时停帧省电
    if (props.paused || !appActive.value) return
    tick.value = tick.value + step
    if (impact.value > 0) {
      impact.value = impact.value - 0.08 * step
      if (impact.value < 0) impact.value = 0
    }
  }, frameMs)
})

onUnmounted(() => {
  if (timer != 0) {
    clearInterval(timer)
    timer = 0
  }
})
</script>

<style>
.kt {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.kt__cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  /* 变换基准放在字底，融化/弹跳才有"落下去"的重量感 */
  transform-origin: 50% 100%;
}

.kt__ch {
  /* 关闭系统字体回退导致的基线抖动 */
  font-variant-ligatures: none;
}
</style>

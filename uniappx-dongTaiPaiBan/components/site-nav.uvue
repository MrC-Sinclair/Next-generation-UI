<template>
  <view>
    <!-- 宽屏：顶部横向导航 -->
    <view v-if="mode === 'top'" class="top" :style="topStyle">
      <view class="top__inner" :style="innerStyle">
        <view class="brand" @click="go('/pages/index/index')">
          <text class="brand__mark">◐</text>
          <text class="brand__name">{{ brand }}</text>
        </view>
        <view class="top__list">
          <view
            v-for="item in items"
            :key="item.key"
            class="top__item"
            :class="item.key === current ? 'top__item--on' : ''"
            @click="go(item.path)"
          >
            <text class="top__txt">{{ item.label }}</text>
            <view v-if="item.key === current" class="top__dot"></view>
          </view>
        </view>
        <view class="top__meta">
          <view class="theme-switch" hover-class="press" @click="onToggleTheme">
            <text class="theme-switch__t">{{ themeText }}</text>
          </view>
          <text class="top__meta-t">{{ meta }}</text>
        </view>
      </view>
    </view>

    <!-- 窄屏：底部 Tab -->
    <view v-else class="bottom" :style="bottomStyle">
      <view
        v-for="item in items"
        :key="item.key"
        class="bottom__item"
        :class="item.key === current ? 'bottom__item--on' : ''"
        @click="go(item.path)"
      >
        <text class="bottom__icon">{{ item.icon }}</text>
        <text class="bottom__txt">{{ item.label }}</text>
      </view>
      <!-- #12：主题切换悬浮胶囊（右上角，避开 Tab 导航） -->
      <view class="bottom__theme" :style="themeFabStyle" hover-class="press" @click="onToggleTheme">
        <text class="theme-switch__t">{{ themeText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, type ComputedRef } from 'vue'
import { NAV_ITEMS, SITE, type NavItem } from '../common/site'
import { theme, toggleTheme } from '../common/theme'

const props = defineProps({
  /** top = 宽屏顶部导航；bottom = 窄屏底部 Tab */
  mode: { type: String, default: 'top' },
  current: { type: String, default: 'index' },
  statusBarHeight: { type: Number, default: 0 },
  safeBottom: { type: Number, default: 0 },
  gutter: { type: Number, default: 40 },
  contentMax: { type: Number, default: 1180 }
})

const items: NavItem[] = NAV_ITEMS
const brand = SITE.latin
const meta = SITE.location

/** #12：手动切换入口文案——显示点击后的去向，点击即切换并持久化 */
const themeText: ComputedRef<string> = computed(() => {
  return theme.value === 'light' ? '切到深色' : '切到浅色'
})

/** 窄屏悬浮按钮位置：贴底部 Tab 上方（safeBottom 之上 76px） */
const themeFabStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'bottom': (props.safeBottom + 76) + 'px'
  }
})

/** #12：点击切换深浅色主题（立即生效，无需重启） */
function onToggleTheme(): void {
  toggleTheme()
}

const topStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'padding-top': props.statusBarHeight + 'px',
    'padding-left': props.gutter + 'px',
    'padding-right': props.gutter + 'px'
  }
})

const innerStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'max-width': props.contentMax + 'px'
  }
})

const bottomStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'padding-bottom': (props.safeBottom + 8) + 'px'
  }
})

function go(path: string) {
  // 用 redirectTo 而不是 navigateTo：栏目切换不该无限压栈
  uni.redirectTo({
    url: path,
    fail: () => {
      uni.switchTab({ url: path })
    }
  })
}
</script>

<style>
/* ---------- 顶部导航 ---------- */
.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  background-color: var(--c-nav-bg);
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: var(--c-hairline);
}

.top__inner {
  height: 68px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-left: auto;
  margin-right: auto;
}

.brand {
  flex-direction: row;
  align-items: center;
}

.brand__mark {
  font-size: 20px;
  color: var(--c-accent);
  margin-right: 10px;
}

.brand__name {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--c-paper);
}

.top__list {
  flex-direction: row;
  align-items: center;
}

.top__item {
  padding-left: 16px;
  padding-right: 16px;
  height: 68px;
  align-items: center;
  justify-content: center;
  position: relative;
}

.top__txt {
  font-size: 14px;
  color: var(--c-weak);
  letter-spacing: 1px;
}

.top__item--on .top__txt {
  color: var(--c-paper);
  font-weight: 700;
}

.top__dot {
  position: absolute;
  bottom: 14px;
  width: 16px;
  height: 2px;
  background-color: var(--c-accent);
  border-radius: 1px;
}

.top__meta-t {
  font-size: 12px;
  /* 评审 #6：弱提示 ≥ 0.5（对齐 T_WEAK） */
  color: var(--c-weak);
  letter-spacing: 1px;
}

/* ---------- 底部 Tab ---------- */
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  flex-direction: row;
  align-items: center;
  background-color: var(--c-tab-bg);
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: var(--c-hairline);
  padding-top: 6px;
}

.bottom__item {
  flex: 1;
  height: 52px;
  align-items: center;
  justify-content: center;
}

.bottom__icon {
  font-size: 16px;
  /* 评审 #6：弱提示 ≥ 0.5（对齐 T_WEAK） */
  color: var(--c-weak);
  margin-bottom: 3px;
}

.bottom__txt {
  /* 评审 #6：字号 10→11px、alpha 0.4→0.5，底部 Tab 更可读 */
  font-size: 11px;
  color: var(--c-weak);
  letter-spacing: 0.5px;
}

.bottom__item--on .bottom__icon {
  color: var(--c-accent);
}

.bottom__item--on .bottom__txt {
  color: var(--c-paper);
  font-weight: 700;
}

/* 评审 #9：hover-class="press" 按压反馈（导航项/品牌区） */
.press { opacity: 0.72; }

/* ---------- 主题切换入口（#12） ---------- */
.top__meta {
  flex-direction: row;
  align-items: center;
}

.theme-switch {
  height: 28px;
  padding-left: 12px;
  padding-right: 12px;
  margin-right: 14px;
  border-radius: 999px;
  border-width: 1px;
  border-style: solid;
  border-color: var(--c-border);
  background-color: var(--c-surface);
  align-items: center;
  justify-content: center;
}

.theme-switch__t {
  font-size: 12px;
  letter-spacing: 1px;
  /* 评审 #6：弱提示 ≥ 0.5 */
  color: var(--c-weak);
}

/* 窄屏底部 Tab：右上悬浮胶囊（避开 Tab，z-index 高于底部导航） */
.bottom__theme {
  position: fixed;
  right: 18px;
  z-index: 901;
  height: 30px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 999px;
  border-width: 1px;
  border-style: solid;
  border-color: var(--c-border);
  background-color: var(--c-tab-bg);
  align-items: center;
  justify-content: center;
}
</style>

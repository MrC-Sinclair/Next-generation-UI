    "router": {
      "mode": "hash",
      "base": "./"
    },
    "devServer": {
      "port": 5173,
      "https": false
    }
  },
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "minified": true

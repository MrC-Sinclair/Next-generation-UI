/**
 * 站点静态内容
 * 全部集中在这里，方便接入接口后整体替换为远程数据
 */

/* ================= UI 设计 Token（唯一真源） =================
 * 新增/修改配色先改这里，再同步到各页面/组件 <style>。
 * 注意：uvue 静态 CSS 无法引用 UTS 常量，页面里的硬编码值需与下列值保持一致，
 * 故此处既是文档也是登记表。
 */
export const C_BG = '#0B0B0F'            // 页面底色
export const C_PAPER = '#F5F3EF'         // 纸白（主文字）
export const C_ACCENT = '#FF4D2E'        // 朱红（强调 / 主品牌色）
export const C_VIOLET = '#7C5CFF'        // 紫
export const C_GREEN = '#00E5A0'         // 绿
export const C_AMBER = '#FFB020'         // 橙（紧绷）
export const C_SURFACE = 'rgba(245,243,239,0.035)' // 卡片表面
export const C_BORDER = 'rgba(245,243,239,0.09)'   // 卡片描边
export const T_BODY = 0.72               // 正文文本不透明度（纸白叠加）
export const T_SECONDARY = 0.6           // 次要文本不透明度
export const T_WEAK = 0.5                // 弱提示不透明度（最低可见层级）
/** 全局动效开关：设为 false 时 kinetic-text 全部静态渲染（系统减弱动效时的降级入口） */
export const ALLOW_MOTION = true

/* ================= 主题语义 Token（#12） =================
 * 拆分 LIGHT/DARK 两套语义值，C_* / T_* 为深色原版的登记别名。
 * CSS 侧落地：App.uvue 中 .theme--dark/.theme--light 定义同名 CSS 变量
 * var(--c-*)，页面/组件 <style> 一律引用变量，数值须与本表保持一致。
 * JS 内联侧落地：统一 themeResolve()（common/theme.uts）。
 */
export type ThemeName = 'dark' | 'light'

export type ThemeTokens = {
  /** 页面底色 */
  bg: string
  /** 主文字（纸白/深墨） */
  paper: string
  /** 弱提示（≥0.5 alpha 层） */
  weak: string
  /** 次要文本（≥0.6） */
  secondary: string
  /** 正文（≥0.72） */
  body: string
  /** 界面弱填充（0.3 层） */
  dim: string
  /** 卡片表面 */
  surface: string
  /** 弱面板/呼吸层（0.12~0.14） */
  soft: string
  /** 进度条轨道等中性填充（0.1） */
  track: string
  /** 分隔细线（0.08） */
  hairline: string
  /** 卡片描边（0.09） */
  border: string
  /** 滚动条滑块 */
  scroll: string
  /** 滚动条滑块 hover */
  scrollHover: string
  /** 顶部导航栏底色 */
  navBg: string
  /** 底部 Tab 底色 */
  tabBg: string
  /** 朱红强调 / 主品牌色 */
  accent: string
  /** 紫 */
  violet: string
  /** 绿 */
  green: string
  /** 橙（紧绷） */
  amber: string
  /** 紫标签文字（亮紫） */
  violetTxt: string
}


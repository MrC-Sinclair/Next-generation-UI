/**
 * 站点静态内容
 * 全部集中在这里，方便接入接口后整体替换为远程数据
 */

export type NavItem = {
  key: string
  label: string
  icon: string
  path: string
  desc: string
}

export type StatItem = {
  value: string
  label: string
  unit: string
  mode: string
  /** 进度条填充百分比，直接写死，避免运行时算 hash */
  pct: number
}

export type TimelineItem = {
  year: string
  title: string
  org: string
  desc: string
}


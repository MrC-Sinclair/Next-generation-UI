/** 情绪 → 排版动效的映射，这是本站的核心玩法 */
export type MoodItem = {
  key: string
  label: string
  mode: string
  desc: string
  color: string
  /** 浅色主题下的加深强调色（#12） */
  colorLight: string
}

export const MOODS: MoodItem[] = [
  { key: 'calm', label: '平静', mode: 'breathe', desc: '缓慢起伏，像水面', color: '#7C5CFF', colorLight: '#5433D6' },

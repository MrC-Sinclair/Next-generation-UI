<template>
  <view class="page" :class="themeClass">
    <view class="glow" :style="glowStyle"></view>

    <site-nav
      :mode="navMode"
      current="about"
      :status-bar-height="statusBarHeight"
      :safe-bottom="safeBottom"
      :gutter="gutter"
      :content-max="contentMax"
    ></site-nav>

    <view class="content" :style="contentStyle">
      <view class="wrap" :style="wrapStyle">

        <!-- ============ 标题 ============ -->
        <view class="hero" :style="heroStyle">
          <view class="eyebrow">
            <text class="eyebrow__t">ABOUT · 关于我</text>
          </view>
          <kinetic-text
            text="关于我"
            mode="melt"
            :font-size="heroSize"
            :amplitude="heroSize * 0.13"
            :speed="0.7"
            accent="#FF4D2E"
            color="#F5F3EF"
            font-weight="800"
            :interactive="true"
          ></kinetic-text>
          <kinetic-text
            text="LIN SHEN"
            mode="wave"
            :font-size="heroSize * 0.28"
            :amplitude="heroSize * 0.05"
            :speed="0.9"
            accent="#F5F3EF"
            color="rgba(245,243,239,0.55)"
            font-weight="400"
            :letter-spacing="6"
          ></kinetic-text>
        </view>

        <!-- ============ 简介 ============ -->
        <site-section
          index="01"
          title="个人简介"
          subtitle="一句话版本，与稍长一些的版本。"
          title-mode="breathe"
          :title-size="titleSize"
          :margin-top="heroGap"
        >
          <view class="prose" :style="proseStyle">
            <text class="prose__p">{{ SITE.intro }}</text>
            <text class="prose__p">
              我做跨端开发，也做设计。这两个身份在我这里不太分得开——写页面的时候我会先想它「动起来的节奏」，画稿的时候又会忍不住算一遍渲染开销。
            </text>
            <text class="prose__p">
              这几年主要在一件事上较劲：怎么让文字在屏幕上有情绪。不是加个入场动画就完事，而是让「扭曲」「弹跳」「融化」这些形变本身成为语义的一部分——一句紧张的话应该是歪的，一句松弛的话应该慢慢呼吸。
            </text>
            <text class="prose__p">
              除此之外：咖啡喝得太多，爬山爬得太少，收藏了四百多篇没读的文章。
            </text>
          </view>
        </site-section>

        <!-- ============ 情绪排版实验室 ============ -->
        <site-section
          index="02"
          title="情绪排版"
          subtitle="选择一种情绪，观察同一文本的形变差异。"
          title-mode="glitch"
          :title-size="titleSize"
          :margin-top="sectionGap"
        >
          <view class="lab" :style="labStyle">
            <!-- 情绪选择器 -->
            <view class="moods">
              <view
                v-for="m in MOODS"
                :key="m.key"
                class="mood"
                :class="m.key === moodKey ? 'mood--on' : ''"
                :style="moodStyle(m)"
                hover-class="press"
                @click="pickMood(m.key)"
              >
                <text class="mood__t" :style="moodTextStyle(m)">{{ m.label }}</text>
              </view>
            </view>

            <!-- 预览区 -->
            <view class="stage" :style="stageStyle">
              <view class="stage__head">
                <text class="stage__mode">{{ mood.mode.toUpperCase() }}</text>
                <text class="stage__speed">SPEED ×{{ moodSpeed.toFixed(1) }}</text>
              </view>

              <view class="stage__body">
                <kinetic-text
                  :text="phrase"
                  :mode="mood.mode"
                  :font-size="stageSize"
                  :amplitude="stageSize * 0.16 * moodAmpRatio"
                  :speed="moodSpeed"
                  :accent="mood.color"
                  color="#F5F3EF"
                  font-weight="800"
                  :interactive="true"
                ></kinetic-text>
              </view>

              <view class="stage__foot">
                <text class="stage__desc">{{ mood.desc }}</text>
                <view class="stage__slider">
                  <text class="stage__slider-t">慢</text>
                  <slider
                    class="stage__slider-c"
                    :value="speedVal"
                    min="20"
                    max="240"
                    :background-color="trackColor"
                    :active-color="resolvedMoodColor(mood)"
                    :block-color="resolvedMoodColor(mood)"
                    :block-size="18"
                    @changing="onSpeed"
                  ></slider>
                  <text class="stage__slider-t">快</text>
                </view>
              </view>
            </view>
          </view>
        </site-section>

        <!-- ============ 经历时间线 ============ -->
        <site-section
          index="03"
          title="经历"
          subtitle="按时间倒序排列。"
          title-mode="wave"
          :title-size="titleSize"
          :margin-top="sectionGap"
        >
          <view class="tl">
            <view v-for="(t, i) in TIMELINE" :key="i" class="tl__item" :style="tlStyle">
              <view class="tl__rail">
                <view class="tl__dot"></view>
                <view v-if="i < TIMELINE.length - 1" class="tl__line"></view>
              </view>
              <view class="tl__main">
                <text class="tl__year">{{ t.year }}</text>
                <kinetic-text
                  :text="t.title"
                  mode="distort"
                  :font-size="tlTitleSize"
                  :amplitude="tlTitleSize * 0.2"
                  :speed="0.7"
                  accent="#FF4D2E"
                  color="#F5F3EF"
                  font-weight="700"
                ></kinetic-text>
                <text class="tl__org">{{ t.org }}</text>
                <text class="tl__desc">{{ t.desc }}</text>
              </view>
            </view>
          </view>
        </site-section>

        <!-- ============ 一点私人细节 ============ -->
        <site-section
          index="04"
          title="杂项"
          subtitle="一些碎片化的补充说明。"
          title-mode="bounce"
          :title-size="titleSize"
          :margin-top="sectionGap"
        >
          <view class="facts" :style="factsStyle">
            <view v-for="(f, i) in FACTS" :key="i" class="fact" :style="factStyle">
              <text class="fact__k">{{ f.k }}</text>
              <text class="fact__v">{{ f.v }}</text>
            </view>
          </view>
        </site-section>

        <!-- ============ 下一步 ============ -->
        <view class="next" :style="nextStyle">
          <kinetic-text
            text="保持联系"
            mode="wave"
            :font-size="nextSize"
            :amplitude="nextSize * 0.14"
            :speed="0.8"
            accent="#FF4D2E"
            color="#F5F3EF"
            font-weight="800"
            :interactive="true"
            @press="go('/pages/contact/contact')"
          ></kinetic-text>
          <view class="next__row">
            <view class="btn btn--solid" hover-class="press" @click="go('/pages/contact/contact')">
              <text class="btn__t btn__t--dark">联系我</text>
            </view>
            <view class="btn btn--ghost" hover-class="press" @click="go('/pages/portfolio/portfolio')">
              <text class="btn__t">浏览作品集</text>
            </view>
          </view>
        </view>

      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, type ComputedRef, type Ref } from 'vue'
import { useViewport } from '../../composables/use-viewport'
import { SITE, MOODS, TIMELINE, FACTS, type MoodItem, type TimelineItem } from '../../common/site'
import { themeClass, themeResolve } from '../../common/theme'

const {
  winWidth,
  statusBarHeight,
  safeBottom,
  isWide,
  navMode,
  contentMax,
  gutter,
  heroSize,
  titleSize
} = useViewport()

/* ---------------- 情绪实验室状态 ---------------- */

const moodKey: Ref<string> = ref('melt')
/** 速度滑杆原始值 20~240，映射到 0.2~2.4 倍速 */
const speedVal: Ref<number> = ref(90)

const phrase = '文字会传达情绪'

const mood: ComputedRef<MoodItem> = computed(() => {
  for (let i = 0; i < MOODS.length; i++) {
    if (MOODS[i].key === moodKey.value) return MOODS[i]
  }
  return MOODS[0]
})

const moodSpeed: ComputedRef<number> = computed(() => speedVal.value / 100)

/** 不同情绪的形变幅度系数：平静几乎不动，失真最夸张 */
const moodAmpRatio: ComputedRef<number> = computed(() => {
  const k = moodKey.value
  if (k === 'calm') return 0.35
  if (k === 'drift') return 0.8
  if (k === 'happy') return 1.0
  if (k === 'tense') return 1.15
  if (k === 'melt') return 1.0
  return 1.3
})

function pickMood(key: string) {
  moodKey.value = key
  // 换情绪时给个轻量的震动反馈，移动端才生效
  uni.vibrateShort({ fail: () => {} })
}

function onSpeed(e: any) {
  speedVal.value = e.detail.value as number
}

/* ---------------- 响应式尺寸 ---------------- */

const stageSize: ComputedRef<number> = computed(() => {
  const w = winWidth.value
  if (w >= 1440) return 78
  if (w >= 1024) return 66
  if (w >= 600) return 54
  return 34
})

const tlTitleSize: ComputedRef<number> = computed(() => (isWide.value ? 24 : 19))
const nextSize: ComputedRef<number> = computed(() => heroSize.value * 0.62)

const contentStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'padding-top': (statusBarHeight.value + (isWide.value ? 68 : 20)) + 'px',
    'padding-bottom': (safeBottom.value + (isWide.value ? 80 : 118)) + 'px'
  }
})

const wrapStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s: UTSJSONObject = {
    'padding-left': gutter.value + 'px',
    'padding-right': gutter.value + 'px'
  }
  if (contentMax.value > 0) {
    s['max-width'] = contentMax.value + 'px'
    s['align-self'] = 'center'
  }
  return s
})

const heroStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return { 'padding-top': (isWide.value ? 64 : 28) + 'px' }
})

const heroGap: ComputedRef<number> = computed(() => (isWide.value ? 88 : 56))
const sectionGap: ComputedRef<number> = computed(() => (isWide.value ? 88 : 60))

const proseStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s: UTSJSONObject = {}
  if (isWide.value) s['max-width'] = '680px'
  return s
})

const labStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'flex-direction': isWide.value ? 'row' : 'column',
    'align-items': isWide.value ? 'stretch' : 'flex-start'
  }
})

const stageStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s: UTSJSONObject = {
    'border-color': mood.value.color + '33',
    'margin-top': isWide.value ? '0px' : '20px',
    'flex': isWide.value ? 1 : 0
  }
  return s
})

/** #12：slider 轨道色（深色纸白 12% / 浅色墨色 10%） */
const trackColor: ComputedRef<string> = computed(() => themeResolve('rgba(245,243,239,0.12)'))

/** #12：情绪主色经主题解析——深色原值，浅色自动换深强调色 */
function resolvedMoodColor(m: MoodItem): string {
  return themeResolve(m.color)
}

const moodStyle = (m: MoodItem): UTSJSONObject => {
  const on = m.key === moodKey.value
  const mc = themeResolve(m.color)
  const s: UTSJSONObject = {
    'border-color': on ? mc : themeResolve('rgba(245,243,239,0.14)')
  }
  if (on) s['background-color'] = mc + '1F'
  return s
}

const moodTextStyle = (m: MoodItem): UTSJSONObject => {
  return {
    'color': m.key === moodKey.value ? themeResolve(m.color) : themeResolve('rgba(245,243,239,0.5)')
  }
}

const tlStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return { 'flex-direction': 'row' }
})

const factsStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'flex-wrap': 'wrap',
    'margin-left': '-8px',
    'margin-right': '-8px'
  }
})

const factStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const w = winWidth.value
  let pct = '100%'
  if (w >= 1024) pct = '33.3333%'
  else if (w >= 600) pct = '50%'
  return {
    'width': pct,
    'padding-left': '8px',
    'padding-right': '8px',
    'margin-bottom': '16px'
  }
})

const nextStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return { 'margin-top': (isWide.value ? 104 : 72) + 'px' }
})

const glowStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s = heroSize.value * 2.4
  return {
    'width': s + 'px',
    'height': s + 'px',
    'top': '-' + (s * 0.4).toFixed(0) + 'px',
    'right': '-' + (s * 0.35).toFixed(0) + 'px',
    'background-color': mood.value.color
  }
})

function go(path: string) {
  uni.redirectTo({
    url: path,
    fail: () => {
      uni.switchTab({ url: path })
    }
  })
}
</script>

<style>
.page {
  width: 100%;
  min-height: 100%;
  background-color: var(--c-bg);
}

.content {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
}

.wrap {
  width: 100%;
  flex-direction: column;
}

.glow {
  position: absolute;
  border-radius: 9999px;
  opacity: 0.09;
  pointer-events: none;
}

.hero {
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  z-index: 2;
}

.eyebrow {
  margin-bottom: 18px;
  padding-left: 12px;
  padding-right: 14px;
  padding-top: 6px;
  padding-bottom: 6px;
  border-radius: 999px;
  border-width: 1px;
  border-style: solid;
  border-color: var(--c-soft);
}

.eyebrow__t {
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--c-secondary);
}

/* ---------- 正文 ---------- */
.prose {
  width: 100%;
  flex-direction: column;
}

.prose__p {
  font-size: 16px;
  line-height: 30px;
  /* 评审 #6：正文 ≥ 0.72（对齐 T_BODY） */
  color: var(--c-body);
  margin-bottom: 20px;
  letter-spacing: 0.5px;
}

/* ---------- 实验室 ---------- */
.lab {
  width: 100%;
}

.moods {
  width: 190px;
  flex-shrink: 0;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
}

.mood {
  padding-left: 14px;
  padding-right: 14px;
  padding-top: 9px;
  padding-bottom: 9px;
  border-radius: 10px;
  border-width: 1px;
  border-style: solid;
  margin-right: 8px;
  margin-bottom: 8px;
  cursor: pointer;
}

.mood__t {
  font-size: 13px;
  letter-spacing: 1px;
  font-weight: 600;
}

.stage {
  flex: 1;
  width: 100%;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  background-color: var(--c-surface);
  padding: 22px;
  min-height: 230px;
}

.stage__head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}

.stage__mode {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  /* 评审 #6：弱提示 ≥ 0.5（对齐 T_WEAK） */
  color: var(--c-weak);
}

.stage__speed {
  font-size: 11px;
  letter-spacing: 1px;
  /* 评审 #6：弱提示 ≥ 0.5（对齐 T_WEAK） */
  color: var(--c-weak);
}

.stage__body {
  flex: 1;
  align-items: center;
  justify-content: flex-start;
  padding-top: 10px;
  padding-bottom: 10px;
}

.stage__foot {
  margin-top: 18px;
}

.stage__desc {
  font-size: 13px;
  /* 评审 #6：次要文本 ≥ 0.6（对齐 T_SECONDARY） */
  color: var(--c-secondary);
  letter-spacing: 0.5px;
  margin-bottom: 14px;
}

.stage__slider {
  flex-direction: row;
  align-items: center;
}

.stage__slider-t {
  font-size: 11px;
  color: var(--c-dim);
}

.stage__slider-c {
  flex: 1;
  margin-left: 10px;
  margin-right: 10px;
}

/* ---------- 时间线 ---------- */
.tl {
  width: 100%;
}

.tl__item {
  width: 100%;
}

.tl__rail {
  width: 24px;
  flex-shrink: 0;
  align-items: center;
  padding-top: 8px;
}

.tl__dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: var(--c-accent);
}

.tl__line {
  width: 1px;
  flex: 1;
  background-color: var(--c-soft);
  margin-top: 6px;
}

.tl__main {
  flex: 1;
  padding-bottom: 28px;
}

.tl__year {
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--c-accent);
  font-weight: 700;
  margin-bottom: 6px;
}

.tl__org {
  margin-top: 8px;
  font-size: 12px;
  letter-spacing: 1px;
  /* 评审 #6：弱提示 ≥ 0.5（对齐 T_WEAK） */
  color: var(--c-weak);
}

.tl__desc {
  margin-top: 10px;
  font-size: 14px;
  line-height: 25px;
  /* 评审 #6：次要文本 ≥ 0.6（对齐 T_SECONDARY） */
  color: var(--c-secondary);
}

/* 评审 #9：hover-class="press" 按压反馈（情绪按钮等），叠加轻微缩放增强按压手感 */
.press { opacity: 0.72; transform: scale(0.98); }

/* ---------- 琐事 ---------- */
.facts {
  flex-direction: row;
}

.fact {
  flex-direction: column;
  align-items: flex-start;
}

.fact__k {
  font-size: 12px;
  letter-spacing: 1.5px;
  color: var(--c-violet);
  margin-bottom: 8px;
}

.fact__v {
  font-size: 14px;
  line-height: 24px;
  color: var(--c-secondary);
}

/* ---------- 下一步 ---------- */
.next {
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
}

.next__row {
  margin-top: 26px;
  width: 100%;
}

.btn {
  height: 48px;
  padding-left: 26px;
  padding-right: 26px;
  border-radius: 24px;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  cursor: pointer;
}

.btn--solid {
  background-color: var(--c-accent);
}

.btn--ghost {
  border-width: 1px;
  border-style: solid;
  border-color: var(--c-scroll);
}

.btn__t {
  font-size: 15px;
  font-weight: 600;
  color: var(--c-paper);
}

.btn__t--dark {
  color: var(--c-bg);
  font-weight: 700;
}
</style>

<template>
  <view class="page" :class="themeClass">
    <site-nav
      :mode="navMode"
      current="portfolio"
      :status-bar-height="statusBarHeight"
      :safe-bottom="safeBottom"
      :gutter="gutter"
      :content-max="contentMax"
    ></site-nav>

    <view class="content" :style="contentStyle">
      <view class="wrap" :style="wrapStyle">
        <view class="head" :style="headStyle">
          <kinetic-text
            text="作品集"
            mode="melt"
            :font-size="heroSize"
            :amplitude="heroSize * 0.12"
            :speed="0.7"
            accent="#FF4D2E"
            color="#F5F3EF"
            font-weight="800"
            :interactive="true"
          ></kinetic-text>
          <text class="head__sub">正在一个一个搬过来，先留个位置。</text>
        </view>

        <view class="grid" :style="gridStyle">
          <view v-for="(p, i) in LIST" :key="i" class="item" :style="itemStyle">
            <view class="item__top">
              <site-tag :text="p.tag" color="#00E5A0" bg="rgba(0,229,160,0.14)"></site-tag>
              <text class="item__year">{{ p.year }}</text>
            </view>
            <kinetic-text
              :text="p.name"
              :mode="p.mode"
              :font-size="24"
              :amplitude="3"
              :speed="0.75"
              accent="#00E5A0"
              color="#F5F3EF"
              font-weight="700"
            ></kinetic-text>
            <text class="item__desc">{{ p.desc }}</text>
          </view>
        </view>

        <!-- 评审 #9：hover-class 提供按压反馈（uvue 无 :active/:hover 伪类，用官方 hover-class） -->
        <view class="back" hover-class="press" @click="go('/pages/index/index')">
          <text class="back__t">← 回概览</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, type ComputedRef } from 'vue'
import { useViewport } from '../../composables/use-viewport'
import { LIST } from '../../common/site'
import { themeClass } from '../../common/theme'

const { winWidth, statusBarHeight, safeBottom, isWide, navMode, contentMax, gutter, heroSize } =
  useViewport()

/** 评审 #11：页头间距与 about/index 对齐（窄屏 28 / 宽屏 64） */
const headStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return { 'padding-top': (isWide.value ? 64 : 28) + 'px' }
})

const contentStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'padding-top': (statusBarHeight.value + (isWide.value ? 68 : 20)) + 'px',
    'padding-bottom': (safeBottom.value + (isWide.value ? 80 : 118)) + 'px'
  }
})

const wrapStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s: UTSJSONObject = {
    'padding-left': gutter.value + 'px',
    'padding-right': gutter.value + 'px'
  }
  if (contentMax.value > 0) {
    s['max-width'] = contentMax.value + 'px'
    s['align-self'] = 'center'
  }
  return s
})

const gridStyle: ComputedRef<UTSJSONObject> = computed(() => ({
  'flex-wrap': 'wrap',
  'margin-left': '-8px',
  'margin-right': '-8px'
}))

const itemStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const w = winWidth.value
  let pct = '100%'
  if (w >= 1024) pct = '50%'
  else if (w >= 600) pct = '50%'
  return {
    'width': pct,
    'padding-left': '8px',
    'padding-right': '8px',
    'margin-bottom': '16px'
  }
})

function go(path: string) {
  uni.redirectTo({ url: path, fail: () => { uni.switchTab({ url: path }) } })
}
</script>

<style>
.page { width: 100%; min-height: 100%; background-color: var(--c-bg); }
.content { width: 100%; flex-direction: column; align-items: stretch; }
.wrap { width: 100%; flex-direction: column; }
.head { padding-top: 40px; flex-direction: column; align-items: flex-start; } /* 评审 #11：实际生效间距由内联 headStyle 提供（窄 28 / 宽 64），此处保留兜底 */
.head__sub { margin-top: 20px; font-size: 14px; color: var(--c-secondary); letter-spacing: 1px; } /* 评审 #6：次要文本 ≥ 0.6 */
.grid { flex-direction: row; margin-top: 48px; }
/* 评审 #8：卡片视觉与 index/contact 统一为一套值（同底色/描边/圆角/内距） */
.item {
  background-color: var(--c-surface);
  border-width: 1px; border-style: solid; border-color: var(--c-border);
  border-radius: 14px; padding: 22px; flex-direction: column; align-items: flex-start;
}
.item__top { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 16px; }
.item__year { font-size: 11px; letter-spacing: 1px; color: var(--c-weak); } /* 评审 #6：弱文本 ≥ 0.5 */
.item__desc { margin-top: 12px; font-size: 13px; line-height: 22px; color: var(--c-secondary); } /* 评审 #6：次要文本 ≥ 0.6 */
.back { margin-top: 56px; }
.back__t { font-size: 14px; color: var(--c-weak); letter-spacing: 1px; }
/* 评审 #9：hover-class="press" 按压反馈 */
.press { opacity: 0.72; }
</style>

<template>
  <view class="page">
    <site-nav
      :mode="navMode"
      current="portfolio"
      :status-bar-height="statusBarHeight"
      :safe-bottom="safeBottom"
      :gutter="gutter"
      :content-max="contentMax"
    ></site-nav>

    <view class="content" :style="contentStyle">
      <view class="wrap" :style="wrapStyle">
        <view class="head">
          <kinetic-text
            text="作品集"
            mode="melt"
            :font-size="heroSize"
            :amplitude="heroSize * 0.12"
            :speed="0.7"
            accent="#FF4D2E"
            color="#F5F3EF"
            font-weight="800"
            :interactive="true"
          ></kinetic-text>
          <text class="head__sub">正在一个一个搬过来，先留个位置。</text>
        </view>

        <view class="grid" :style="gridStyle">
          <view v-for="(p, i) in LIST" :key="i" class="item" :style="itemStyle">
            <view class="item__top">
              <text class="item__tag">{{ p.tag }}</text>
              <text class="item__year">{{ p.year }}</text>
            </view>
            <kinetic-text
              :text="p.name"
              :mode="p.mode"
              :font-size="24"
              :amplitude="3"
              :speed="0.75"
              accent="#00E5A0"
              color="#F5F3EF"
              font-weight="700"
            ></kinetic-text>
            <text class="item__desc">{{ p.desc }}</text>
          </view>
        </view>

        <view class="back" @click="go('/pages/index/index')">
          <text class="back__t">← 回概览</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, type ComputedRef } from 'vue'
import { useViewport } from '../../composables/use-viewport'

const { winWidth, statusBarHeight, safeBottom, isWide, navMode, contentMax, gutter, heroSize } =
  useViewport()

const LIST = [
  { tag: '开源', year: '2026', name: 'kinetic-type', desc: '跨端动态排版引擎，本站正在用的那套。', mode: 'wave' },
  { tag: '商业', year: '2025', name: '独立书店导视系统', desc: '会呼吸的电子墨水牌，32 块屏同步。', mode: 'breathe' },
  { tag: '工具', year: '2024', name: '网格生成器', desc: '给设计师用的版式网格与基线计算器。', mode: 'distort' },
  { tag: '实验', year: '2024', name: '融化字体', desc: '把可变字重接到温度数据上的一次尝试。', mode: 'melt' }
]

const contentStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'padding-top': (statusBarHeight.value + (isWide.value ? 68 : 20)) + 'px',
    'padding-bottom': (safeBottom.value + (isWide.value ? 80 : 118)) + 'px'
  }
})

const wrapStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s: UTSJSONObject = {
    'padding-left': gutter.value + 'px',
    'padding-right': gutter.value + 'px'
  }
  if (contentMax.value > 0) {
    s['max-width'] = contentMax.value + 'px'
    s['align-self'] = 'center'
  }
  return s
})

const gridStyle: ComputedRef<UTSJSONObject> = computed(() => ({
  'flex-wrap': 'wrap',
  'margin-left': '-8px',
  'margin-right': '-8px'
}))

const itemStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const w = winWidth.value
  let pct = '100%'
  if (w >= 1024) pct = '50%'
  else if (w >= 600) pct = '50%'
  return {
    'width': pct,
    'padding-left': '8px',
    'padding-right': '8px',
    'margin-bottom': '16px'
  }
})

function go(path: string) {
  uni.redirectTo({ url: path, fail: () => { uni.switchTab({ url: path }) } })
}
</script>

<style>
.page { width: 100%; min-height: 100%; background-color: #0B0B0F; }
.content { width: 100%; flex-direction: column; align-items: stretch; }
.wrap { width: 100%; flex-direction: column; }
.head { padding-top: 40px; flex-direction: column; align-items: flex-start; }
.head__sub { margin-top: 20px; font-size: 14px; color: rgba(245,243,239,0.45); letter-spacing: 1px; }
.grid { flex-direction: row; margin-top: 48px; }
.item {
  background-color: rgba(245,243,239,0.035);
  border-width: 1px; border-style: solid; border-color: rgba(245,243,239,0.09);
  border-radius: 14px; padding: 22px; flex-direction: column; align-items: flex-start;
}
.item__top { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 16px; }
.item__tag { font-size: 11px; letter-spacing: 1px; color: #00E5A0; }
.item__year { font-size: 11px; letter-spacing: 1px; color: rgba(245,243,239,0.3); }
.item__desc { margin-top: 12px; font-size: 13px; line-height: 22px; color: rgba(245,243,239,0.45); }
.back { margin-top: 56px; }
.back__t { font-size: 14px; color: rgba(245,243,239,0.5); letter-spacing: 1px; }
</style>

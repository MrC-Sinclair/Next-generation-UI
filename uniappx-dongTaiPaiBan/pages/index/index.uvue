  width: 100%;
  min-height: 100%;
  background-color: #0B0B0F;
}

.content {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
}

.wrap {
  width: 100%;
  flex-direction: column;
}

/* ---------- 背景光斑 ---------- */
.glow {
  position: absolute;
  border-radius: 9999px;
  opacity: 0.16;
  pointer-events: none;
}

.glow--a {
  background-color: #FF4D2E;
}

.glow--b {
  background-color: #7C5CFF;
  opacity: 0.12;
}

/* ---------- HERO ---------- */
.hero {
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  z-index: 2;
}

.eyebrow {
  flex-direction: row;
  align-items: center;
  margin-bottom: 22px;
  padding-left: 12px;
  padding-right: 14px;
  padding-top: 6px;
  padding-bottom: 6px;
  border-radius: 999px;
  border-width: 1px;
  border-style: solid;
  border-color: rgba(245, 243, 239, 0.14);
}

.eyebrow__dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #00E5A0;
  margin-right: 8px;
}

.eyebrow__t {
  font-size: 11px;
  letter-spacing: 2px;
  color: rgba(245, 243, 239, 0.6);
}

.hero__intro {
  margin-top: 26px;
  color: rgba(245, 243, 239, 0.58);
  letter-spacing: 0.5px;
}

.hero__cta {
  margin-top: 32px;
  width: 100%;
}

.hero__cta--row {
  flex-direction: row;
  align-items: center;
  width: auto;
}

.btn {
  height: 48px;
  padding-left: 26px;
  padding-right: 26px;
  border-radius: 24px;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}


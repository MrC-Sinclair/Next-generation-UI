}

/* ---------- 统计 ---------- */
.stats {
  flex-direction: row;
}

.stat {
  flex-direction: column;
  align-items: flex-start;
}

.stat__num {
  flex-direction: row;
  align-items: baseline;
}

.stat__unit {
  margin-left: 4px;
  color: #FF4D2E;
  font-weight: 700;
}

.stat__label {
  margin-top: 8px;
  font-size: 13px;
  letter-spacing: 1px;
  color: rgba(245, 243, 239, 0.5);
}

.stat__bar {
  margin-top: 14px;
  width: 100%;
  height: 2px;
  background-color: rgba(245, 243, 239, 0.1);
  border-radius: 1px;
}

.stat__bar-fill {
  height: 2px;
  background-color: #FF4D2E;
  border-radius: 1px;
}

/* ---------- 入口卡片 ---------- */
.cards {
  flex-direction: row;
}

.card {
  background-color: rgba(245, 243, 239, 0.035);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(245, 243, 239, 0.09);
  border-radius: 14px;
  padding: 22px;
  flex-direction: column;
  align-items: flex-start;
}

.card__icon {
  font-size: 20px;
  color: #FF4D2E;
  margin-bottom: 14px;
}

.card__label {
  font-size: 18px;
  font-weight: 700;
  color: #F5F3EF;

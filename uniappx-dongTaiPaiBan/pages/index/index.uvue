  margin-bottom: 8px;
}

.card__desc {
  font-size: 13px;
  line-height: 22px;
  color: rgba(245, 243, 239, 0.45);
}

.card__arrow {
  margin-top: 18px;
}

.card__arrow-t {
  font-size: 16px;
  color: rgba(245, 243, 239, 0.3);
}

/* ---------- 最近动态 ---------- */
.feeds {
  width: 100%;
}

.feed {
  width: 100%;
  padding-top: 20px;
  padding-bottom: 20px;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: rgba(245, 243, 239, 0.08);
}

.feed__date {
  width: 76px;
  flex-shrink: 0;
}

.feed__date-t {
  font-size: 12px;
  letter-spacing: 1px;
  color: rgba(245, 243, 239, 0.32);
}

.feed__main {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.feed__tag {
  margin-bottom: 8px;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-radius: 4px;
  background-color: rgba(124, 92, 255, 0.16);
}

.feed__tag-t {
  font-size: 10px;
  letter-spacing: 1px;
  color: #A08CFF;
}

/* ---------- 页脚 ---------- */
.foot {
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
}

.foot__line {
  width: 100%;
  height: 1px;
  background-color: rgba(245, 243, 239, 0.1);
  margin-bottom: 22px;
}

.foot__t {
  font-size: 14px;
  color: rgba(245, 243, 239, 0.7);
  letter-spacing: 1px;
}

.foot__s {
  margin-top: 8px;
  font-size: 12px;
  color: rgba(245, 243, 239, 0.3);
  letter-spacing: 1px;
}
</style>

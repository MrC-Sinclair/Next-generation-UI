<template>
  <view class="page" :class="themeClass">
    <site-nav
      :mode="navMode"
      current="blog"
      :status-bar-height="statusBarHeight"
      :safe-bottom="safeBottom"
      :gutter="gutter"
      :content-max="contentMax"
    ></site-nav>

    <view class="content" :style="contentStyle">
      <view class="wrap" :style="wrapStyle">
        <view class="head" :style="headStyle">
          <kinetic-text
            text="博客"
            mode="wave"
            :font-size="heroSize"
            :amplitude="heroSize * 0.12"
            :speed="0.8"
            accent="#00E5A0"
            color="#F5F3EF"
            font-weight="800"
            :interactive="true"
          ></kinetic-text>
          <text class="head__sub">写下来的思考，按时间倒序。</text>
        </view>

        <view class="list">
          <view v-for="(a, i) in POSTS" :key="i" class="post">
            <view class="post__meta">
              <text class="post__date">{{ a.date }}</text>
              <site-tag :text="a.tag" color="#A08CFF" bg="rgba(124,92,255,0.16)"></site-tag>
            </view>
            <kinetic-text
              :text="a.title"
              :mode="a.mode"
              :font-size="isWide ? 22 : 18"
              :amplitude="isWide ? 3 : 2.5"
              :speed="0.75"
              accent="#7C5CFF"
              color="#F5F3EF"
              font-weight="700"
            ></kinetic-text>
            <text class="post__desc">{{ a.desc }}</text>
            <view class="post__line"></view>
          </view>
        </view>

        <!-- 评审 #9：hover-class 提供按压反馈（uvue 无 :active/:hover 伪类，用官方 hover-class） -->
        <view class="back" hover-class="press" @click="go('/pages/index/index')">
          <text class="back__t">← 回概览</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, type ComputedRef } from 'vue'
import { useViewport } from '../../composables/use-viewport'
import { POSTS } from '../../common/site'
import { themeClass } from '../../common/theme'

const { statusBarHeight, safeBottom, isWide, navMode, contentMax, gutter, heroSize } = useViewport()

/** 评审 #11：页头间距与 about/index 对齐（窄屏 28 / 宽屏 64） */
const headStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return { 'padding-top': (isWide.value ? 64 : 28) + 'px' }
})

const contentStyle: ComputedRef<UTSJSONObject> = computed(() => {
  return {
    'padding-top': (statusBarHeight.value + (isWide.value ? 68 : 20)) + 'px',
    'padding-bottom': (safeBottom.value + (isWide.value ? 80 : 118)) + 'px'
  }
})

const wrapStyle: ComputedRef<UTSJSONObject> = computed(() => {
  const s: UTSJSONObject = {
    'padding-left': gutter.value + 'px',
    'padding-right': gutter.value + 'px'
  }
  if (contentMax.value > 0) {
    s['max-width'] = contentMax.value + 'px'
    s['align-self'] = 'center'
  }
  return s
})

function go(path: string) {
  uni.redirectTo({ url: path, fail: () => { uni.switchTab({ url: path }) } })
}
</script>

<style>
.page { width: 100%; min-height: 100%; background-color: var(--c-bg); }
.content { width: 100%; flex-direction: column; align-items: stretch; }
.wrap { width: 100%; flex-direction: column; }
.head { padding-top: 40px; flex-direction: column; align-items: flex-start; } /* 评审 #11：实际生效间距由内联 headStyle 提供（窄 28 / 宽 64），此处保留兜底 */
.head__sub { margin-top: 20px; font-size: 14px; color: var(--c-secondary); letter-spacing: 1px; } /* 评审 #6：次要文本 ≥ 0.6 */
.list { margin-top: 44px; width: 100%; }
.post { flex-direction: column; align-items: flex-start; padding-top: 24px; padding-bottom: 24px; }
.post__meta { flex-direction: row; align-items: center; margin-bottom: 10px; }
.post__date { font-size: 12px; letter-spacing: 1px; color: var(--c-weak); margin-right: 12px; } /* 评审 #6：弱文本 ≥ 0.5 */
/* 评审 #8：标签已统一走 site-tag 组件（原 .post__tag 文本标签移除） */
.post__desc { margin-top: 12px; font-size: 14px; line-height: 24px; color: var(--c-secondary); } /* 评审 #6：次要文本 ≥ 0.6 */
.post__line { width: 100%; height: 1px; background-color: var(--c-hairline); margin-top: 22px; }
.back { margin-top: 40px; }
.back__t { font-size: 14px; color: var(--c-weak); letter-spacing: 1px; }
/* 评审 #9：hover-class="press" 按压反馈 */
.press { opacity: 0.72; }
</style>
